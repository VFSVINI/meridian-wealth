# Copie para .env (nunca versionado). Todas as chaves são opcionais.
# Sem chaves, o sistema usa Yahoo, Stooq, Frankfurter e RSS (sem chave).
# Não existe modo simulado: sem provedor, o painel mostra "sem dado em tempo real".
FINNHUB_API_KEY=
FRED_API_KEY=
# brapi.dev (B3): sem token, só os tickers de teste (PETR4, VALE3, ITUB4, MGLU3).
MW_BRAPI_TOKEN=
# Stooq passou a exigir verificação JavaScript; fica desligado por padrão.
MW_STOOQ_ENABLED=false
# WebSocket de negócios da Finnhub (só conecta com FINNHUB_API_KEY).
MW_FINNHUB_WS=true
# Stream de cripto: Binance, com failover automático para Coinbase e Kraken (sem chave).
MW_CRYPTO_STREAM=true
# Feed pago plugável (desligado): none | twelvedata. O selo declara o atraso do plano.
MW_PAID_FEED=none
MW_PAID_FEED_KEY=
MW_PAID_FEED_FRESHNESS=DELAYED
# Ligados automaticamente pelo docker-compose.yml:
# MW_CACHE_TYPE=memory
# MW_PERSISTENCE=false

# --- Segurança e login (item #11; detalhes em docs/seguranca.md) ---
# Segredo do JWT (mínimo 32 caracteres). Sem ele, um segredo aleatório é gerado a cada partida e as sessões não sobrevivem a um reinício.
# Gere um valor forte, por exemplo: openssl rand -base64 48
MW_JWT_SECRET=
# Login com Google: ID do cliente OAuth (termina em .apps.googleusercontent.com). Vazio = Login com Google desligado.
MW_GOOGLE_CLIENT_ID=
# Reservado: o fluxo de ID token não usa o segredo do cliente. Não coloque valores reais em arquivos versionados.
MW_GOOGLE_CLIENT_SECRET=
# Proxies cujo X-Forwarded-For vale (IPs ou CIDR, separados por vírgula). Vazio = o cabeçalho é ignorado.
MW_TRUSTED_PROXIES=
# Origens exatas liberadas para CORS (sem curinga). Vazio = só a própria origem.
MW_CORS_ORIGINS=
MW_DEMO_MODE=true
MW_REGISTRATION=true

# --- Observabilidade (item #14; detalhes em docs/observabilidade.md) ---
# Token Bearer das métricas (/actuator/prometheus e /actuator/metrics), mínimo 24 caracteres. Vazio = esses caminhos não existem (404).
# Gere um valor forte, por exemplo: openssl rand -base64 32
MW_METRICS_TOKEN=

# --- Segurança da camada de borda (Issue #43; detalhes em docs/seguranca-checklist.md) ---
# true = HTTP puro recebe 308 para o HTTPS. Atrás de um proxy que termina o TLS, liste o proxy em MW_TRUSTED_PROXIES, senão toda requisição parece HTTP.
MW_FORCE_HTTPS=false
# true = liga o Swagger e /v3/api-docs (lista todas as rotas). Deixe desligado fora do desenvolvimento.
MW_API_DOCS=false

# --- Deploy (item #21; detalhes em docs/deploy.md) ---
# PORT=7860                  # Hugging Face Spaces
# DB_POOL_SIZE=5             # Neon gratuito limita conexões
# DB_CONNECT_TIMEOUT_MS=30000
